# =====================================================================
# Gettik Render.com Production Environment (.env.render.example)
# Render Dashboard mein Environment Variables mein yeh values set karo
# Ya render.yaml mein define karo (already done)
# =====================================================================

ENVIRONMENT=production
DEBUG=false

# Render automatically 0.0.0.0 bind karta hai
APP_HOST=0.0.0.0
APP_PORT=8000

# Render deploy hone ke baad apna URL yahan daalo:
# Format: https://YOUR-APP-NAME.onrender.com
API_BASE_URL=https://gettik-backend.onrender.com
ADMIN_BASE_URL=https://gettik-backend.onrender.com/admin

# CORS — Hostinger domain + apna Render domain
# Hostinger domain: yourdomain.com ya yourname.hostingersite.com
CORS_ORIGINS=https://gettik-backend.onrender.com,https://yourdomain.com,http://localhost:8000

# Database
# Option 1: SQLite (simple, lekin Render restart pe reset ho jaata hai)
DATABASE_URL=sqlite:///data/gettik.db
# Option 2: Render PostgreSQL (recommended for production — free tier available)
# DATABASE_URL=postgresql://user:password@hostname/dbname

# Redis (optional — memory fallback available agar Redis nahi hai)
# Render Redis add-on se milega:
# REDIS_URL=redis://red-xxxxx.oregon-postgres.render.com:6379

# Download workers (Render free tier par 3 rakhna better hai)
GETTIK_DOWNLOAD_WORKERS=3

# Downloaded files storage (Render ephemeral disk par)
DOWNLOAD_STORAGE_PATH=./data/downloads

# SECURITY — ZAROORI: Strong random values use karo!
# Generate karne k liye: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_32_CHARS
SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET_MIN_32_CHARS
