# =====================================================================
# Gettik Hostinger Production Environment Configuration (.env.example)
# Copy this file to .env and set your production values.
# =====================================================================

# Environment mode: 'production' or 'development'
ENVIRONMENT=production
DEBUG=false

# Application Binding Host & Port (0.0.0.0 for public VPS binding)
APP_HOST=0.0.0.0
APP_PORT=8000

# Public Production URLs (Replace with your actual Hostinger domain)
API_BASE_URL=https://api.yourdomain.com
ADMIN_BASE_URL=https://api.yourdomain.com/admin

# CORS Allowed Origins (Comma-separated list of allowed clients)
# Include your desktop app origins, web domains, and admin portal
CORS_ORIGINS=https://api.yourdomain.com,https://yourdomain.com,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration:
# - Leave empty or set file path for SQLite: sqlite:///data/gettik.db
# - PostgreSQL example: postgresql://username:password@localhost:5432/gettik_db
DATABASE_URL=sqlite:///data/gettik.db

# Optional Redis Cache / Worker Queue (Leave empty for fallback memory queue)
# REDIS_URL=redis://localhost:6379/0

# Worker Concurrency Configuration (Default: 5 concurrent workers)
GETTIK_DOWNLOAD_WORKERS=5

# Persistent Physical Download Storage Path on Server
# Defaults to ./data/downloads if empty
DOWNLOAD_STORAGE_PATH=./data/downloads

# Production Cryptographic Secrets (CHANGE THESE FOR YOUR DEPLOYMENT!)
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_key_2026_xyz
SESSION_SECRET=change_this_to_a_secure_random_session_secret_key_2026_abc
