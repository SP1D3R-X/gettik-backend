[Unit]
Description=Gettik Production FastAPI Backend Service
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/var/www/gettik-backend
EnvironmentFile=/var/www/gettik-backend/.env
ExecStart=/var/www/gettik-backend/venv/bin/gunicorn -c gunicorn.conf.py src.main:app
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
